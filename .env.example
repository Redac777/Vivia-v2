# Copier ce fichier en .env (gitignoré) et renseigner les valeurs.
# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# GitHub -> fine-grained token (permissions : Contents + Pull requests en Read/write, Metadata Read-only)
# Sert a l'agent pour pousser les branches, ouvrir et merger les PR (/pr-watch).
GITHUB_TOKEN=
